# Local environment and credentials
.venv/
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python caches, notebook state, and package builds
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Keep source PDFs; ignore generated datasets and other local data
/data/*
!/data/jobs/
/data/jobs/*
!/data/jobs/*.[pP][dD][fF]

# Keep the scheduler log directory, but ignore generated contents
/artifacts/*
!/artifacts/ingestion/
/artifacts/ingestion/*
!/artifacts/ingestion/.gitkeep

# Reports, exports, and local generated files
*.db
*.db-*
.coverage
.coverage.*
coverage.xml
htmlcov/
/output/
/ops/*.plist
.DS_Store
